{
  "manifest_version": 3,
  "name": "PoE Ninja Build Cost",
  "version": "0.5.0",
  "description": "Estimates what a poe.ninja build costs, using poe.ninja's public economy API and the official trade site.",
  "homepage_url": "https://github.com/yaredmax/poe-ninja-build-cost",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://poe.ninja/*",
    "https://www.pathofexile.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://poe.ninja/poe1/builds/*",
        "https://poe.ninja/poe1/profile/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://poe.ninja/poe1/builds/*",
        "https://poe.ninja/poe1/profile/*"
      ],
      "js": [
        "src/settings.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PoE Ninja Build Cost",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
